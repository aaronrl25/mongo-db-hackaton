# The app runs in demo mode without secrets.
MONGODB_URI=mongodb+srv://...
MONGODB_DB=devpersona
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
ELEVENLABS_API_KEY=...
ELEVENLABS_AGENT_ID=...
PORT=8787
AUTH_SECRET=replace-with-a-long-random-secret
# Only needed if you intentionally want dev bypass in a production build.
ALLOW_DEV_ACCESS=false
